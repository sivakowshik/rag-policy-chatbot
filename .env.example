# Copy this file to .env and fill in your own values.
# Never commit .env — it is listed in .gitignore.

# --- Azure OpenAI (or a Microsoft Foundry project with Azure OpenAI models) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names you chose when deploying the models
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Must match the embedding model (text-embedding-3-small = 1536)
EMBEDDING_DIMENSIONS=1536

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX=restaurant-policies

# --- Retrieval / chunking settings ---
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
